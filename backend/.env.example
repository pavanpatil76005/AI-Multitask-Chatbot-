# For managed production databases such as Neon, set DATABASE_URL instead of
# the discrete DB_* values. Keep CORS_ORIGINS as a comma-separated list or JSON.
DATABASE_URL=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=ai_chatbot
DB_USER=postgres
DB_PASSWORD=replace_with_your_local_password
SECRET_KEY=replace_with_a_random_secret_of_at_least_32_characters
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
GEMINI_SECOND_FALLBACK_MODEL=gemini-3.5-flash-lite
